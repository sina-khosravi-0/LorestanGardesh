<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                android:text="@string/hotel_reservation"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <HorizontalScrollView
                    android:id="@+id/filter_scroll_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:animateLayoutChanges="true"
                    android:scrollbars="none"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:id="@+id/filter_linear_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/sort_type_chip_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:animateLayoutChanges="true"
                            app:selectionRequired="true"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/sort_type_chip"
                                style="@style/Widget.Material3.Chip.Filter.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/cheapest"
                                app:checkedIconEnabled="false"
                                app:chipIcon="@drawable/ic_sort"
                                app:chipIconEnabled="true"
                                app:chipIconTint="?attr/colorPrimary"
                                app:closeIcon="@drawable/ic_expand_more"
                                app:closeIconEnabled="true" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/filter_star_chip_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:animateLayoutChanges="true"
                            app:selectionRequired="true"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_star_chip"
                                style="@style/Widget.Material3.Chip.Filter.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/_4_star"
                                app:checkedIconEnabled="false"
                                app:chipIcon="@drawable/baseline_star_outline_24"
                                app:chipIconEnabled="true"
                                app:chipIconTint="?attr/colorPrimary"
                                app:closeIcon="@drawable/ic_expand_more"
                                app:closeIconEnabled="true" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/filter_guest_number_chip_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:animateLayoutChanges="true"
                            app:selectionRequired="true"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_guest_number_chip"
                                style="@style/Widget.Material3.Chip.Filter.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/_2_beds"
                                app:checkedIconEnabled="false"
                                app:chipIcon="@drawable/baseline_person_outline_24"
                                app:chipIconEnabled="true"
                                app:chipIconTint="?attr/colorPrimary"
                                app:closeIcon="@drawable/ic_expand_more"
                                app:closeIconEnabled="true" />
                        </com.google.android.material.chip.ChipGroup>

                        <!--            <com.google.android.material.chip.ChipGroup-->
                        <!--                android:id="@+id/filter_chip_group"-->
                        <!--                android:layout_width="wrap_content"-->
                        <!--                android:layout_height="wrap_content"-->
                        <!--                android:animateLayoutChanges="true"-->
                        <!--                app:singleLine="true">-->

                        <!--                <com.google.android.material.chip.Chip-->
                        <!--                    style="@style/Widget.Material3.Chip.Filter"-->
                        <!--                    android:layout_width="wrap_content"-->
                        <!--                    android:layout_height="wrap_content"-->
                        <!--                    android:text="@string/antiquities" />-->

                        <!--                <com.google.android.material.chip.Chip-->
                        <!--                    style="@style/Widget.Material3.Chip.Filter"-->
                        <!--                    android:layout_width="wrap_content"-->
                        <!--                    android:layout_height="wrap_content"-->
                        <!--                    android:text="@string/nature" />-->

                        <!--                <com.google.android.material.chip.Chip-->
                        <!--                    style="@style/Widget.Material3.Chip.Filter"-->
                        <!--                    android:layout_width="wrap_content"-->
                        <!--                    android:layout_height="wrap_content"-->
                        <!--                    android:text="@string/bazaar" />-->

                        <!--                <com.google.android.material.chip.Chip-->
                        <!--                    style="@style/Widget.Material3.Chip.Filter"-->
                        <!--                    android:layout_width="wrap_content"-->
                        <!--                    android:layout_height="wrap_content"-->
                        <!--                    android:text="@string/museum" />-->
                        <!--            </com.google.android.material.chip.ChipGroup>-->
                    </LinearLayout>
                </HorizontalScrollView>


                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/city_chip_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:animateLayoutChanges="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/filter_scroll_view"
                    app:selectionRequired="true"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/city_chip"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="خرم آباد"
                        app:checkedIconEnabled="false"
                        app:chipIcon="@drawable/baseline_location_city_24"
                        app:chipIconEnabled="true"
                        app:chipIconTint="?attr/colorPrimary"
                        app:closeIcon="@drawable/ic_expand_more"
                        app:closeIconEnabled="true" />
                </com.google.android.material.chip.ChipGroup>

                <!--            <com.google.android.material.chip.ChipGroup-->
                <!--                android:id="@+id/filter_chip_group"-->
                <!--                android:layout_width="wrap_content"-->
                <!--                android:layout_height="wrap_content"-->
                <!--                android:animateLayoutChanges="true"-->
                <!--                app:singleLine="true">-->

