<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.bus.BusTicketResultsFragment">

    <HorizontalScrollView
        android:id="@+id/filter_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:layoutDirection="ltr"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/filter_linear_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sort_type_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:animateLayoutChanges="true"
                app:selectionRequired="true"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/sort_type_chip"
                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/cheapest"
                    app:checkedIconEnabled="false"
                    app:chipIcon="@drawable/ic_sort"
                    app:chipIconEnabled="true"
                    app:chipIconTint="?attr/colorPrimary"
                    app:closeIcon="@drawable/ic_expand_more"
                    app:closeIconEnabled="true" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:animateLayoutChanges="true"
                app:selectionRequired="true"
                app:singleLine="true">

                <com.google.android.material.chip.Chip

                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/from_price"
                    app:checkedIconEnabled="false"
                    app:chipIcon="@drawable/ic_start_arrow"
                    app:chipIconEnabled="true"
                    app:chipIconTint="?attr/colorPrimary"
                    app:closeIcon="@drawable/ic_expand_more"
                    app:closeIconEnabled="true" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:animateLayoutChanges="true"
                app:selectionRequired="true"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/to_price"
                    app:checkedIconEnabled="false"
                    app:chipIcon="@drawable/ic_finish_arrow"
                    app:chipIconEnabled="true"
                    app:chipIconTint="?attr/colorPrimary"
                    app:closeIcon="@drawable/ic_expand_more"
                    app:closeIconEnabled="true" />
            </com.google.android.material.chip.ChipGroup>

            <!--            <com.google.android.material.chip.ChipGroup-->
            <!--                android:id="@+id/filter_chip_group"-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:animateLayoutChanges="true"-->
            <!--                app:singleLine="true">-->

            <!--                <com.google.android.material.chip.Chip-->
            <!--                    style="@style/Widget.Material3.Chip.Filter"-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:text="@string/antiquities" />-->

            <!--                <com.google.android.material.chip.Chip-->
            <!--                    style="@style/Widget.Material3.Chip.Filter"-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:text="@string/nature" />-->

            <!--                <com.google.android.material.chip.Chip-->
            <!--                    style="@style/Widget.Material3.Chip.Filter"-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:text="@string/bazaar" />-->

            <!--                <com.google.android.material.chip.Chip-->
            <!--                    style="@style/Widget.Material3.Chip.Filter"-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:text="@string/museum" />-->
            <!--            </com.google.android.material.chip.ChipGroup>-->
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bus_ticket_results_recycler"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/bus_fragment_ticket_search_result"
        app:layout_constraintTop_toBottomOf="@+id/filter_scroll_view" />

</androidx.constraintlayout.widget.ConstraintLayout>